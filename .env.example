# Runtime mode. Set to production only in deployed environments; production
# startup validates every required variable below and rejects mock providers.
NODE_ENV=development
PORT=3001

# Database. Production hosts with a DNS name must use ?sslmode=verify-full.
DATABASE_URL=postgres://fitpal:fitpal@localhost:5432/fitpal

# Redis. Production hosts with a DNS name must use rediss://.
REDIS_URL=redis://localhost:6379

# Meilisearch
MEILI_HOST=http://localhost:7700
MEILI_MASTER_KEY=master-key

# S3 / MinIO
S3_ENDPOINT=http://localhost:9000
S3_REGION=ap-south-1
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_BUCKET=fitpal

# Auth / Google OAuth
# GOOGLE_REDIRECT_URI must be registered exactly as an authorized redirect URI
# in Google Cloud Console. Host URLs must match the published ports in
# docker/docker-compose.yml (api on host 3011, web on host 3002).
GOOGLE_CLIENT_ID=change-me
GOOGLE_CLIENT_SECRET=change-me
GOOGLE_REDIRECT_URI=http://localhost:3011/api/v1/auth/google/callback
# Fixed web destination. Callback query parameters cannot override it.
# Production requires https here and an exact match in CORS_ORIGIN.
CLIENT_URL=http://localhost:3002
# Exact browser origins allowed with credentials. No wildcards; production
# requires https and must include CLIENT_URL.
CORS_ORIGIN=http://localhost:3000,http://localhost:3002
# Comma-separated allowlist of mobile deep-link schemes (bare schemes only).
# Expo Go uses exp; dev/standalone builds use fitpal. The guard rejects
# http/https/javascript/data but does not reject exp, so omit it in production.
MOBILE_OAUTH_SCHEMES=exp,fitpal

# Email. Gmail SMTP is the only implemented provider and the only value the
# production guard accepts. It is development-only guidance; moving to a
# verified-domain provider requires provider and guard changes.
# Use a Google App Password, NOT the regular Gmail password. Never commit credentials.
EMAIL_PROVIDER=gmail
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=support.fitpal@gmail.com
SMTP_PASSWORD=
EMAIL_FROM=FitPal <support.fitpal@gmail.com>
# Required in production; explicit reply-to identity.
REPLY_TO=FitPal <support.fitpal@gmail.com>

# SMS. Local development uses mock; production must set disabled until a real
# provider is implemented. mock is rejected at production startup.
SMS_MODE=mock

# OTP HMAC pepper (generate a unique 32+ character value, e.g. `openssl rand -hex 32`)
# Never reuse another application secret. Rotating it invalidates every OTP.
OTP_PEPPER=

# Client IP trust. Leave unset for direct connections: the socket address is used
# and X-Forwarded-For is ignored. Set only to the exact IP of a proxy that sets or
# sanitizes X-Forwarded-For for this API.
TRUSTED_PROXY_IP=

# AI (LLM)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Next.js
NEXT_PUBLIC_API_URL=http://localhost:3011
