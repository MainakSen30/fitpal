{
  "name": "fitpal",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "lint": "turbo lint",
    "typecheck": "turbo typecheck",
    "clean": "turbo clean",
    "format": "@biomejs/biome format --write .",
    "db:generate": "bun run --cwd packages/database generate",
    "db:migrate": "bun run --cwd packages/database migrate",
    "db:push": "bun run --cwd packages/database push"
  },
  "devDependencies": {
    "@biomejs/biome": "^1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "framer-motion": "^14.8.0",
    "lucide-react": "^1.65.0",
    "tailwind-merge": "^3.7.0",
    "turbo": "^2",
    "typescript": "^5"
  },
  "packageManager": "bun@1.3.14",
  "dependencies": {
    "motion": "^14.9.0",
    "query-string": "^10.0.0"
  }
}
