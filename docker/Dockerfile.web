FROM node:22-alpine AS base
WORKDIR /app

# Install dependencies
# npm workspaces = all workspaces, so apps/mobile's package.json is needed too
COPY package.json package-lock.json* ./
COPY apps/web/package.json ./apps/web/
COPY apps/mobile/package.json ./apps/mobile/
COPY packages/database/package.json ./packages/database/
COPY packages/shared/package.json ./packages/shared/
COPY packages/ai/package.json ./packages/ai/
RUN npm ci

# Copy source
COPY . .

# NEXT_PUBLIC_* variables are inlined into the browser bundle at build time
# (next docs: they are frozen with the build). Compose also passes
# NEXT_PUBLIC_API_URL at runtime for server-side reads — the two must match
# whatever host port the api is published on locally / per environment.
ARG NEXT_PUBLIC_API_URL=http://localhost:3011
ENV NEXT_PUBLIC_API_URL=$NEXT_PUBLIC_API_URL

# Build
RUN npm run build --workspace=@fitpal/web

# Production image
FROM node:22-alpine AS production
WORKDIR /app
COPY --from=base /app/apps/web/.next ./.next
COPY --from=base /app/apps/web/public ./public
COPY --from=base /app/apps/web/package.json ./package.json
COPY --from=base /app/node_modules ./node_modules

EXPOSE 3000
CMD ["npm", "run", "start"]
