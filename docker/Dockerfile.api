# Keep both stages Debian/glibc: prebuilt native addons (@node-rs/bcrypt)
# are built against gnu, and bun's Alpine/musl runtime fails to export the
# napi_* symbols these addons need (dlopen → "symbol not found").
FROM oven/bun:1.3.14 AS base
WORKDIR /app

# Install dependencies
# All workspace package.jsons must be copied: bun.lock tracks every workspace
# (apps/api, apps/mobile, apps/web, packages/ai, packages/database, packages/shared).
# A missing one makes bun treat the lockfile as stale and fail --frozen-lockfile.
COPY package.json bun.lock* ./
COPY apps/api/package.json ./apps/api/
COPY apps/mobile/package.json ./apps/mobile/
COPY apps/web/package.json ./apps/web/
COPY packages/database/package.json ./packages/database/
COPY packages/shared/package.json ./packages/shared/
COPY packages/ai/package.json ./packages/ai/
RUN bun install --frozen-lockfile

# Copy source
COPY . .

# Build
RUN bun run --cwd apps/api build

# Production image — same glibc base so native addons keep loading
FROM oven/bun:1.3.14 AS production
WORKDIR /app
COPY --from=base /app/apps/api/dist ./dist
# bun's isolated layout links native deps only inside the owning workspace's
# node_modules (apps/api/node_modules), which this stage does not ship. The
# bundle keeps @node-rs/bcrypt external (see build script), so re-seed its
# scope directly at /app/node_modules for dist/index.js to resolve.
# COPY preserves symlinks (and would leave them dangling after the re-root),
# so materialize real dirs from the in-image store instead.
COPY --from=base /app/node_modules ./node_modules
RUN rm -rf /app/node_modules/@node-rs && \
    mkdir -p /app/node_modules/@node-rs && \
    cp -RL /app/node_modules/.bun/@node-rs+bcrypt@*/node_modules/@node-rs/. /app/node_modules/@node-rs/

EXPOSE 3001
CMD ["bun", "run", "dist/index.js"]

# Migration image: keeps the full workspace (packages/database + drizzle-kit)
# because the migrate service runs `cd packages/database && bun run migrate`.
# Compose selects it via build.target=migrate.
FROM base AS migrate
