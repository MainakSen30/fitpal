FROM oven/bun:1.3.14 AS base
WORKDIR /app

# Install dependencies
# All workspace package.jsons must be copied: bun.lock tracks every workspace
# (apps/api, apps/mobile, apps/web, packages/ai, packages/database, packages/shared).
# A missing one makes bun treat the lockfile as stale and fail --frozen-lockfile.
COPY package.json bun.lock* ./
COPY apps/api/package.json ./apps/api/
COPY apps/mobile/package.json ./apps/mobile/
COPY apps/web/package.json ./apps/web/
COPY packages/database/package.json ./packages/database/
COPY packages/shared/package.json ./packages/shared/
COPY packages/ai/package.json ./packages/ai/
RUN bun install --frozen-lockfile

# Copy source
COPY . .

# Build
RUN bun run --cwd apps/api build

# Production image
FROM oven/bun:1.3.14-alpine AS production
WORKDIR /app
COPY --from=base /app/apps/api/dist ./dist
COPY --from=base /app/node_modules ./node_modules

EXPOSE 3001
CMD ["bun", "run", "dist/index.js"]

# Migration image: keeps the full workspace (packages/database + drizzle-kit)
# because the migrate service runs `cd packages/database && bun run migrate`.
# Compose selects it via build.target=migrate.
FROM base AS migrate
