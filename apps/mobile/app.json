{
  "expo": {
    "name": "FitPal",
    "slug": "fitpal",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "fitpal",
    "userInterfaceStyle": "dark",
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.fitpal.app"
    },
    "android": {
      "package": "com.fitpal.app"
    },
    "web": {
      "bundler": "metro",
      "output": "static"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-status-bar"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
